Project ShopMe {
  database_type: 'PostgreSQL'
  Note: 'Schema for a multi-vendor e-commerce platform'
}

// --- Enums ---

Enum Role {
  CUSTOMER
  STORE_OWNER
  ADMIN
}

Enum OrderStatus {
  ORDER_PLACED
  PROCESSING
  SHIPPED
  DELIVERED
}

Enum PaymentMethod {
  COD
  STRIPE
}

// --- Tables ---

Table User {
  id string [pk]
  name string
  email string [unique]
  emailVerified datetime
  image string
  hashedPassword string
  cart json [default: `{}`]
  role Role [default: 'CUSTOMER']
  phone string
  gender string
  dateOfBirth datetime
  createdAt datetime [default: `now()`]
  updatedAt datetime [note: 'Automatically updated on change']
}

Table Store {
  id string [pk]
  userId string [unique, not null, ref: - User.id] // one-to-one
  name string [not null]
  description string [not null]
  username string [unique, not null]
  address string [not null]
  status string [default: 'pending', not null]
  isActive bool [default: false, not null]
  logo string [not null]
  email string [not null]
  contact string [not null]
  createdAt datetime [default: `now()`]
  updatedAt datetime
}

Table Product {
  id string [pk]
  name string [not null]
  description string [not null]
  mrp float [not null]
  price float [not null]
  images string[] [not null]
  category string [note: 'Deprecated']
  inStock bool [default: true, not null]
  storeId string [not null]
  categoryId string
  brandId string
  createdAt datetime [default: `now()`]
  updatedAt datetime
}

Table Category {
  id string [pk]
  name string [unique, not null]
  slug string [unique, not null]
  isActive bool [default: true, not null]
  createdAt datetime [default: `now()`]
  updatedAt datetime
}

Table Brand {
  id string [pk]
  name string [unique, not null]
  slug string [unique, not null]
  isActive bool [default: true, not null]
  createdAt datetime [default: `now()`]
  updatedAt datetime
}

Table "Order" {
  id string [pk]
  paymentIntentId string [unique]
  total float [not null]
  status OrderStatus [default: 'ORDER_PLACED', not null]
  userId string [not null]
  storeId string [not null]
  addressId string [not null]
  isPaid bool [default: false, not null]
  paymentMethod PaymentMethod [not null]
  isCouponUsed bool [default: false, not null]
  coupon json [default: `{}`]
  createdAt datetime [default: `now()`]
  updatedAt datetime
}

Table OrderItem {
  orderId string [not null]
  productId string [not null]
  quantity int [not null]
  price float [not null]
  
  indexes {
    (orderId, productId) [pk]
  }
}

Table Address {
  id string [pk]
  userId string [not null]
  name string [not null]
  street string [not null]
  city string [not null]
  state string [not null]
  country string [not null]
  phone string [not null]
  createdAt datetime [default: `now()`]
}

Table Rating {
  id string [pk]
  rating int [not null]
  review string [not null]
  userId string [not null]
  productId string [not null]
  orderId string [not null]
  createdAt datetime [default: `now()`]
  updatedAt datetime
  
  indexes {
    (userId, productId, orderId) [unique]
  }
}

Table Coupon {
  code string [pk]
  description string [not null]
  discount float [not null]
  forNewUser bool [not null]
  forMember bool [default: false, not null]
  isPublic bool [not null]
  expiresAt datetime [not null]
  createdAt datetime [default: `now()`]
}

// --- NextAuth Tables ---

Table Account {
  id string [pk]
  userId string [not null]
  type string [not null]
  provider string [not null]
  providerAccountId string [not null]
  refresh_token string
  access_token string
  expires_at int
  token_type string
  scope string
  id_token string
